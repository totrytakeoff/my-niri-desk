// niri 主配置
// ---------------------------------------------------------------------------
// 这份配置的目标是：
// 1. 保持桌面干净、稳定、可日用；
// 2. 以键盘操作为主，但不牺牲双屏和常用桌面能力；
// 3. 尽量复用你原本 GNOME 下的习惯：kitty / fuzzel / waybar / mako / fcitx5。
//
// niri 配置是 KDL 语法，注释使用 `//`。
// 修改后可以用下面这条命令校验：
//   niri validate -c ~/.config/niri/config.kdl
//
// 常见排错思路：
// - 如果改完不生效：先确认语法校验通过，再重载 niri 配置。
// - 如果某条快捷键没反应：优先检查是否和别的快捷键冲突。
// - 如果某个应用窗口规则没命中：先确认该应用真实的 app-id/title。

input {
    // 键盘输入设置。
    keyboard {
        xkb {
            // 这里可以加 XKB 选项，例如：
            // layout "us"
            // variant "altgr-intl"
            // options "caps:escape"
            //
            // 你现在已经把输入法切换交给 fcitx5，所以这里保持最小化。
        }

        // 开机/登录后默认开启小键盘。
        numlock
    }

    // 触摸板设置。
    touchpad {
        // 单击触摸板 = 点击。
        tap

        // 自然滚动，和 GNOME / macOS 一样：手指向下滑，内容向上。
        natural-scroll

        // 常见可选项，先注释保留：
        // dwt
        //   打字时禁用触摸板，避免误触。
        // accel-speed 0.3
        //   调整触摸板加速度。
        // click-method "clickfinger"
        //   三指/两指点击手势映射。
    }

    mouse {
        // 鼠标当前没有做专门调校，保持系统默认。
        //
        // 常见可选项：
        // natural-scroll
        // accel-speed 0.2
    }
}

layout {
    // 窗口间距。14 属于略宽松的桌面观感，比“极致塞满屏幕”更耐看。
    gaps 5

    // 当列太多时，尽量把当前聚焦列放在更舒服的位置。
    center-focused-column "on-overflow"

    // 预设列宽：切换列宽时会在这些比例之间轮换。
    preset-column-widths {
        proportion 0.38
        proportion 0.50
        proportion 0.62
    }

    // 默认新列宽度，0.56 对 14 寸 3K + 外接 1080p 双屏都比较均衡。
    default-column-width { proportion 0.56; }

    focus-ring {
        // 聚焦边框宽度和颜色。保留边框但不使用传统实体 border，
        // 能兼顾状态可见和整体简洁。
        width 3
        active-color "#8aa1b4"
        inactive-color "#3c4450"
    }

    border {
        // 关闭传统边框，避免视觉过重。
        off
    }

    shadow {
        // 轻阴影：目的是分离层次，而不是做“卡片感”。
        on
        softness 24
        spread 2
        offset x=0 y=4
        color "#00000066"
    }

    // 常见可选项，先注释说明：
    // struts {
    //   left 0
    //   right 0
    //   top 0
    //   bottom 0
    // }
    //   给 bar / shell 保留硬边距。
    //
    // tab-indicator {
    // }
    //   控制 tabbed 列的外观。
}

// 输出设备布局
// ---------------------------------------------------------------------------
// 你当前的实际显示器是：
// - HDMI-A-1: 外接 1920x1080 显示器
// - eDP-1:    笔记本内屏 3072x1920
//
// 这里强制把外接屏放左边，内屏放右边，避免 niri 按探测顺序排错。
output "HDMI-A-1" {
    position x=0 y=0

    // 常见可选项：
    // scale 1.0
    // transform "normal"
    mode "1920x1080@240"
    // variable-refresh-rate true
}

output "eDP-1" {
    // 右侧屏幕的 x 位置取外接屏宽度 1920。
    position x=1920 y=0

    // 常见可选项：
    scale 2.0
    mode "3072x1920@120"
}

// 会话启动项
// ---------------------------------------------------------------------------
// 这些程序在每次进入 niri 会话时启动。
spawn-at-startup "xwayland-satellite"
// 为 X11 程序提供 XWayland 支持；QQ / 微信 / WPS / 某些旧程序会依赖它。

spawn-at-startup "fcitx5"
// 输入法守护进程。没有它，中文输入和候选框都不会工作。

// spawn-at-startup "mako"
// 原来的通知守护进程。切到 QuickShell 后先停用，避免和它自己的通知服务器抢占。

spawn-at-startup "systemctl" "--user" "start" "quickshell.service"
// 顶栏 / 启动器 / 锁屏 / 侧边栏现在统一交给 QuickShell。
// QuickShell 会自动读取 ~/.config/quickshell/shell.qml。

// spawn-at-startup "waybar"
// 旧顶栏，先停用但保留注释，方便随时回退。

spawn-at-startup "nm-applet" "--indicator"
// Archirithm 这套 QuickShell 仍然通过系统托盘承载网络入口。

spawn-at-startup "blueman-applet"
// 蓝牙托盘图标也继续通过系统托盘接入 QuickShell。

spawn-at-startup "awww-daemon"
// QuickShell 的壁纸切换依赖 awww 守护进程。

//开启Polkit 验证代理,用于提权
spawn-at-startup "/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1"

spawn-sh-at-startup "sleep 5; desk-run session-restore"
// 尝试恢复上一次 niri 会话保存下来的应用与大致布局。
// 这里主要恢复：
// - 应用本身是否打开
// - 所在显示器 / 工作区
// - 平铺窗口的大致列布局
// 不负责恢复应用内部文档内容；浏览器 / 编辑器自己的会话恢复仍由应用本身负责。

spawn-sh-at-startup "desk-run session-watch"
// 后台持续保存 niri 会话状态。
// watcher 自己带启动保护期，避免刚登录时把空桌面覆盖成“最后会话”。

spawn-sh-at-startup "awww-daemon -n overview"
// 给 overview / blur 缓存准备独立的 overview 壁纸守护进程。

spawn-sh-at-startup "sleep 1; desk-run wallpaper restore"
// 登录时恢复上次主动选择的壁纸；没有历史记录时再回退到默认壁纸目录的第一张。

// spawn-at-startup "swaybg" "-i" "$HOME/.local/share/backgrounds/default.png" "-m" "fill"
// 旧壁纸方案。改用 awww 后先停用，避免和动态壁纸切换互相覆盖。

// 同步 wl-copy 与 xclip (带防回环桥接)
// clipboard_sync.py 哈希比对 + 3 秒窗口阻断 xwayland-satellite 的同步回环。
spawn-at-startup "wl-paste" "--type" "text" "--watch" "desk-run" "clipboard-sync" "text/plain" ":0"
spawn-at-startup "wl-paste" "--type" "image" "--watch" "desk-run" "clipboard-sync" "image" ":0"

spawn-sh-at-startup "desk-run clipboard-watch"
// cliphist 负责剪贴板历史存储；QuickShell 只负责展示和恢复。





hotkey-overlay {
    // 隐藏所有未绑定的动作，减少干扰。
    hide-not-bound
}

// 尽量让应用使用 Wayland 原生客户端装饰，而不是各自画一套标题栏。
prefer-no-csd

// niri 自带截图默认保存路径；你实际更常用的是下面 binds 里绑定的脚本。
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

animations {
    // 当前不做额外动画定制，保持默认动画行为。
    //
    // 如果以后你觉得窗口切换太硬或太慢，可以从这里开始调。
}

gestures {
    hot-corners {
        // 关闭鼠标碰屏幕角/边缘触发 overview 的行为。
        off
    }

    // 常见可选项：
    // workspace-swipes {
    //     off
    // }
    //   关闭触摸板三指/四指切工作区手势。
}

// 窗口规则
// ---------------------------------------------------------------------------
// 规则的写法是：匹配条件 + 动作。
// 实战中最常见的是：
// - open-floating true
// - default-column-width {}
// - geometry-corner-radius
// - opacity 等

window-rule {
    // 示例：如果你以后重新用 wezterm，给它一个更宽松的默认列宽。
    match app-id=r#"^org\.wezfurlong\.wezterm$"#
    default-column-width {}
}

window-rule {
    // Firefox 画中画窗口始终浮动，避免打乱平铺布局。
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

window-rule {
    // VOFA+ 拖拽组件时会临时创建标题为 `vofa+` 的代理窗口，
    // 主窗口标题则类似 `vofa.plus @1.4.5`。两者 app-id 相同，
    // 因此统一强制进入 floating，避免主窗与拖拽代理窗分属不同布局。
    match app-id=r#"^vofa\+$"#
    open-floating true
}

window-rule {
    // 一些更适合浮动的小工具窗口。
    match app-id=r#"^(com\.github\.wwmm\.pulseeffects|org\.pulseaudio\.pavucontrol|nm-connection-editor|org\.gnome\.Settings|org\.gnome\.FileRoller|com\.gabm\.satty)$"#
    open-floating true
}

window-rule {
    // satty 截图标注工具需要浮动，方便编辑。
    match app-id=r#"^com\.gabm\.satty$"#
    open-floating true
}

window-rule {
    // 全局圆角和几何裁切。
    // 这一条会作用于大多数窗口，让整体风格统一。
    geometry-corner-radius 10
    clip-to-geometry true
}

layer-rule {
    match namespace="awww-daemonoverview"
    place-within-backdrop true
}
// 这一条是 awww 双守护进程方案的关键：
// - 普通 awww-daemon 负责正常桌面的清晰壁纸
// - `awww-daemon -n overview` 负责 overview 专用的模糊壁纸
// `place-within-backdrop true` 会把 overview 这层只放进 niri 的 backdrop，
// 正常桌面不会再常驻显示模糊图。

// 常见但目前没写的规则例子：
// window-rule {
//     match app-id=r#"^QQ$"#
//     open-floating true
// }
//   适合登录框、启动页、悬浮工具窗口。
//
// window-rule {
//     match app-id=r#"^code$"#
//     default-column-width { proportion 0.62; }
// }
//   让 VS Code 默认更宽。

binds {
    // 热键总览
    Mod+Shift+Slash hotkey-overlay-title="Show This Hotkey Overlay" { show-hotkey-overlay; }

    // 应用启动
    Mod+T  hotkey-overlay-title="Terminal: kitty"              { spawn-sh "\"$HOME/.config/my-desk/bin/desk-app-run\" -- kitty"; }
    Ctrl+Alt+T hotkey-overlay-title=null                       { spawn-sh "\"$HOME/.config/my-desk/bin/desk-app-run\" -- kitty"; }
    Mod+D  hotkey-overlay-title="Launcher: quickshell"         { spawn "quickshell" "ipc" "call" "launcher" "toggle"; }
    Alt+Space hotkey-overlay-title=null                         { spawn "quickshell" "ipc" "call" "launcher" "toggle"; }
    Alt+V  hotkey-overlay-title="Clipboard History"             { spawn "quickshell" "ipc" "call" "clipboard" "toggle"; }
    Super+Alt+L hotkey-overlay-title="Lock Screen"              { spawn "quickshell" "ipc" "call" "lock" "open"; }
    Mod+N  hotkey-overlay-title="File Manager: Nautilus"        { spawn-sh "\"$HOME/.config/my-desk/bin/desk-app-run\" -- nautilus --new-window"; }
    Mod+Shift+T hotkey-overlay-title=null                        { spawn "quickshell" "ipc" "call" "island" "tools"; }
    Mod+Shift+W hotkey-overlay-title=null                        { spawn "quickshell" "ipc" "call" "island" "hub"; }
    Mod+F2 hotkey-overlay-title=null                             { spawn "systemctl" "--user" "restart" "quickshell.service"; }

    // 音量与媒体
    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.05+ -l 1.0"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.05-"; }
    XF86AudioMute        allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86AudioMicMute     allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }
    XF86AudioPlay        allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioPrev        allow-when-locked=true { spawn-sh "playerctl previous"; }
    XF86AudioNext        allow-when-locked=true { spawn-sh "playerctl next"; }
    XF86AudioStop        allow-when-locked=true { spawn-sh "playerctl stop"; }

    // 窗口控制
    Mod+O repeat=false hotkey-overlay-title="Toggle Overview" { toggle-overview; }
    Mod+Q repeat=false hotkey-overlay-title="Close Window"    { close-window; }

    // 导航 (箭头 = 主键, HJKL = 备选隐藏)
    Mod+Left  hotkey-overlay-title="Focus Left"  { focus-column-left; }
    Mod+Down  hotkey-overlay-title="Focus Down"  { focus-window-down; }
    Mod+Up    hotkey-overlay-title="Focus Up"    { focus-window-up; }
    Mod+Right hotkey-overlay-title="Focus Right" { focus-column-right; }
    Mod+H     hotkey-overlay-title=null          { focus-column-left; }
    Mod+J     hotkey-overlay-title=null          { focus-window-down; }
    Mod+K     hotkey-overlay-title=null          { focus-window-up; }
    Mod+L     hotkey-overlay-title=null          { focus-column-right; }

    // 移动窗口/列
    Mod+Ctrl+Left  hotkey-overlay-title="Move Left"  { move-column-left; }
    Mod+Ctrl+Down  hotkey-overlay-title="Move Down"  { move-window-down; }
    Mod+Ctrl+Up    hotkey-overlay-title="Move Up"    { move-window-up; }
    Mod+Ctrl+Right hotkey-overlay-title="Move Right" { move-column-right; }
    Mod+Ctrl+H     hotkey-overlay-title=null         { move-column-left; }
    Mod+Ctrl+J     hotkey-overlay-title=null         { move-window-down; }
    Mod+Ctrl+K     hotkey-overlay-title=null         { move-window-up; }
    Mod+Ctrl+L     hotkey-overlay-title=null         { move-column-right; }
    Mod+Home       hotkey-overlay-title=null         { focus-column-first; }
    Mod+End        hotkey-overlay-title=null         { focus-column-last; }
    Mod+Ctrl+Home  hotkey-overlay-title=null         { move-column-to-first; }
    Mod+Ctrl+End   hotkey-overlay-title=null         { move-column-to-last; }

    // 双屏
    Mod+Shift+Page_Up   hotkey-overlay-title="Send Column to Left Monitor"  { move-column-to-monitor-left; }
    Mod+Shift+Page_Down hotkey-overlay-title="Send Column to Right Monitor" { move-column-to-monitor-right; }
    Mod+Shift+H         hotkey-overlay-title=null     { move-column-to-monitor-left; }
    Mod+Shift+J         hotkey-overlay-title=null     { move-column-to-monitor-down; }
    Mod+Shift+K         hotkey-overlay-title=null     { move-column-to-monitor-up; }
    Mod+Shift+L         hotkey-overlay-title=null     { move-column-to-monitor-right; }
    Mod+Shift+Left  hotkey-overlay-title="Focus Left Monitor"  { focus-monitor-left; }
    Mod+Shift+Right hotkey-overlay-title="Focus Right Monitor" { focus-monitor-right; }
    Mod+Shift+Down  hotkey-overlay-title=null { focus-monitor-down; }
    Mod+Shift+Up    hotkey-overlay-title=null { focus-monitor-up; }

    // 工作区
    Mod+Alt+Left  hotkey-overlay-title="Prev Workspace"         { focus-workspace-up; }
    Mod+Alt+Right hotkey-overlay-title="Next Workspace"         { focus-workspace-down; }
    Mod+Alt+Page_Up   hotkey-overlay-title="Send Column to Prev WS" { move-column-to-workspace-up; }
    Mod+Alt+Page_Down hotkey-overlay-title="Send Column to Next WS" { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up    hotkey-overlay-title="Move Workspace Up" { move-workspace-up; }
    Mod+Ctrl+Page_Down  hotkey-overlay-title="Move Workspace Down" { move-workspace-down; }
    Mod+Ctrl+Shift+Left  hotkey-overlay-title="Move Workspace to Left Monitor" { move-workspace-to-monitor-left; }
    Mod+Ctrl+Shift+Right hotkey-overlay-title="Move Workspace to Right Monitor" { move-workspace-to-monitor-right; }

    // 数字工作区 (数量太多, 全隐藏)
    Mod+1 hotkey-overlay-title=null { focus-workspace 1; }
    Mod+2 hotkey-overlay-title=null { focus-workspace 2; }
    Mod+3 hotkey-overlay-title=null { focus-workspace 3; }
    Mod+4 hotkey-overlay-title=null { focus-workspace 4; }
    Mod+5 hotkey-overlay-title=null { focus-workspace 5; }
    Mod+6 hotkey-overlay-title=null { focus-workspace 6; }
    Mod+7 hotkey-overlay-title=null { focus-workspace 7; }
    Mod+8 hotkey-overlay-title=null { focus-workspace 8; }
    Mod+9 hotkey-overlay-title=null { focus-workspace 9; }
    Mod+Ctrl+1 hotkey-overlay-title=null { move-column-to-workspace 1; }
    Mod+Ctrl+2 hotkey-overlay-title=null { move-column-to-workspace 2; }
    Mod+Ctrl+3 hotkey-overlay-title=null { move-column-to-workspace 3; }
    Mod+Ctrl+4 hotkey-overlay-title=null { move-column-to-workspace 4; }
    Mod+Ctrl+5 hotkey-overlay-title=null { move-column-to-workspace 5; }
    Mod+Ctrl+6 hotkey-overlay-title=null { move-column-to-workspace 6; }
    Mod+Ctrl+7 hotkey-overlay-title=null { move-column-to-workspace 7; }
    Mod+Ctrl+8 hotkey-overlay-title=null { move-column-to-workspace 8; }
    Mod+Ctrl+9 hotkey-overlay-title=null { move-column-to-workspace 9; }

    // 列结构调整 (核心保留, 微调隐藏)
    Mod+BracketLeft  hotkey-overlay-title="Consume Left"  { consume-or-expel-window-left; }
    Mod+BracketRight hotkey-overlay-title="Consume Right" { consume-or-expel-window-right; }
    Mod+Comma  hotkey-overlay-title=null { consume-window-into-column; }
    Mod+Period hotkey-overlay-title=null { expel-window-from-column; }

    // 布局模式
    Mod+F     hotkey-overlay-title="Maximize Column"      { maximize-column; }
    Mod+Shift+F hotkey-overlay-title="Fullscreen"         { fullscreen-window; }
    Mod+V     hotkey-overlay-title="Toggle Floating"      { toggle-window-floating; }
    Mod+W     hotkey-overlay-title="Toggle Tabbed"        { toggle-column-tabbed-display; }
    Mod+R     hotkey-overlay-title=null                   { switch-preset-column-width; }
    Mod+Shift+R hotkey-overlay-title=null                 { switch-preset-window-height; }
    Mod+Ctrl+R hotkey-overlay-title=null                  { reset-window-height; }
    Mod+Ctrl+F hotkey-overlay-title=null                  { expand-column-to-available-width; }
    Mod+C     hotkey-overlay-title=null                   { center-column; }
    Mod+Ctrl+C hotkey-overlay-title=null                  { center-visible-columns; }
    Mod+Minus hotkey-overlay-title=null                   { set-column-width "-10%"; }
    Mod+Equal hotkey-overlay-title=null                   { set-column-width "+10%"; }
    Mod+Shift+Minus hotkey-overlay-title=null             { set-window-height "-10%"; }
    Mod+Shift+Equal hotkey-overlay-title=null             { set-window-height "+10%"; }
    Mod+Shift+V hotkey-overlay-title=null                 { switch-focus-between-floating-and-tiling; }

    // 截图
    Mod+P        hotkey-overlay-title="Screenshot (full)"     { screenshot; }
    Alt+Print    hotkey-overlay-title="Screenshot Window"     { screenshot-window; }
    Ctrl+Print   hotkey-overlay-title="Screenshot Screen"    { spawn "desk-run" "screenshot-screen"; }
    Ctrl+Alt+A   hotkey-overlay-title="Screenshot Area"      { spawn "desk-run" "screenshot-area"; }
    Ctrl+Alt+Z   hotkey-overlay-title="Play/Pause Media"     { spawn-sh "playerctl play-pause"; }

    // 其他
    Mod+Escape   hotkey-overlay-title="Toggle Shortcuts Inhibit" allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
    Mod+Shift+E  hotkey-overlay-title="Quit niri"             { quit; }
    Ctrl+Alt+Delete hotkey-overlay-title=null                 { quit; }
    Mod+Shift+P  hotkey-overlay-title="Power Off Monitors"    { power-off-monitors; }
}

debug {
    // 允许接受某些应用携带“无效 serial”的 xdg-activation 请求。
    // 这能改善点击通知、托盘，或把文件/链接交给已启动程序时，
    // 目标窗口没有自动跳到前台的问题。
    // 某些应用或 portal 后端不会按最严格的序列号要求发 activation token，
    // 开启这一项后，niri 会更像传统桌面环境那样接受这类激活请求。
    honor-xdg-activation-with-invalid-serial
}
